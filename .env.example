# Supabase (PostgreSQL) の接続文字列。Supabaseプロジェクト設定 > Database > Connection string
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# 管理者用パスワード(/admin/gate で使用)
ADMIN_PASSWORD="change-me-admin"

# Cookie(セッション)署名用のランダムな秘密文字列。32文字以上を推奨
SESSION_SECRET="change-me-to-a-long-random-string"

# Resend (https://resend.com) のAPIキー
RESEND_API_KEY="re_xxxxxxxxxxxx"

# メール送信元アドレス(Resendで検証済みのドメインが必要)
MAIL_FROM="kintai@yourdomain.com"

# 未出勤アラートcronエンドポイント保護用の秘密文字列。
# Vercelの場合、この値と同名のCRON_SECRET環境変数を設定すると
# Vercel Cronが自動でAuthorization: Bearerヘッダーを付与します。
CRON_SECRET="change-me-to-a-long-random-string"

# 公開URL（管理画面で取引先用URLを表示するため。例 https://example.com）
NEXT_PUBLIC_APP_URL="https://example.com"
