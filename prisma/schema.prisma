// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User and Authentication
model User {
  id    String @id @default(cuid())
  email String @unique
  password String
  name String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  adminSessions AdminSession[]
}

model Session {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AdminSession {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Enumerations for Staff Payment Settings
enum PaymentType {
  DAILY    // 日当（日数 × 単価）
  MONTHLY  // 月固定
}

enum PaymentSchedule {
  REQUEST       // 申請支払い
  FIXED_20      // 毎月20日
  FIXED_25      // 毎月25日
  FIXED_MONTH_END // 月末日
}

// Attendance and Staff Management
model Staff {
  id String @id @default(cuid())
  name String
  email String?
  phone String?
  contract String? // 業務委託契約の参照情報
  status String @default("active") // active, inactive, suspended
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  attendances Attendance[]
  paymentSetting StaffPaymentSetting?
  salaryCalculations SalaryCalculation[]
}

model Attendance {
  id String @id @default(cuid())
  staffId String
  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date DateTime
  startTime DateTime?
  endTime DateTime?
  status String? // present, absent, late, etc.
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([staffId, date])
  @@index([staffId])
  @@index([date])
}

model StaffPaymentSetting {
  id                   String   @id @default(cuid())
  staffId              String   @unique
  staff                Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  // Payment rate and schedule settings
  paymentType          PaymentType?      // DAILY or MONTHLY
  dailyRate            Int?              // 日当の場合の単価（円/日）
  monthlyAmount        Int?              // 月固定の場合の金額
  travelExpenseIncluded Boolean?         // 交通費が単価に含まれるか
  paymentSchedule      PaymentSchedule?  // REQUEST / FIXED_20 / FIXED_25 / FIXED_MONTH_END

  // Bank account information
  bankAccountName      String?
  bankAccountNumber    String?
  bankCode             String?
  branchCode           String?
  accountType          String?

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([staffId])
}

model SalaryCalculation {
  id String @id @default(cuid())
  staffId String
  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  month DateTime // 対象月
  workDays Int? // 勤務日数
  totalAmount Int // 総支給額（円）
  baseSalary Int? // 基本給
  bonus Int? // ボーナス
  deduction Int? // 控除額
  status String @default("draft") // draft, calculated, approved, paid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([staffId, month])
  @@index([staffId])
  @@index([status])
}
