generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum StaffStatus {
  ACTIVE
  RETIRED
}

enum ClockType {
  IN
  OUT
}

enum WorkType {
  BAND
  SPOT
}

enum PaymentMethod {
  FIXED // 固定支払
  REQUEST // 申請支払
}

enum TransferRequestStatus {
  REQUESTING
  PAID
}

// 連続「早出出勤」(シフトの勤務開始時刻より前に出勤打刻した日)の閾値で
// 獲得する通常称号(item 5)。一度獲得したら永久保持。
// EARLY_BIRD は連続記録ではなく「一度でも早出出勤した」ことが条件の特別称号
// (src/lib/game-config.ts の SPECIAL_TITLE_DEFINITIONS 参照)。
enum GameTitleCode {
  CHALLENGER
  TOP_PLAYER
  EXECUTIVE
  PLATINUM_MASTER
  LEGEND
  EARLY_BIRD
}

model Staff {
  id           String      @id @default(cuid())
  employeeCode String      @unique
  name         String
  email        String
  status       StaffStatus @default(ACTIVE)

  // 個人情報(item 4)
  birthDate    DateTime?
  phoneNumber  String?
  address      String?

  // 報酬振込先口座(item 4)
  bankName          String?
  bankBranchName    String?
  bankAccountNumber String?
  bankAccountHolder String?

  // インボイス登録番号(任意, item 4)
  invoiceRegistrationNumber String?

  // ホーム画面に表示するキャラクター(public/characters/<id>/ 配下の画像を参照)。
  // 選択肢は src/lib/character-config.ts で管理。無料でいつでも切り替え可能。
  // "none" = 表示なし、"custom" = 下記の自分でアップロードした写真を使う。
  selectedCharacterId String @default("default")

  // selectedCharacterId="custom" のときに使う、本人がアップロードした写真
  // (data URL文字列としてそのまま保存。出勤前/勤務中/退勤後の3状態分)。
  customAvatarHome  String?
  customAvatarWork  String?
  customAvatarNight String?

  // 支払方法(item 6)
  paymentMethod PaymentMethod @default(REQUEST)

  // 固定支払スケジュール(item 7)。paymentMethod=FIXED の場合のみ使用。
  // 日付は 1-31、月末は 0 で表す。
  fixedClosingDay         Int?
  fixedPaymentMonthOffset Int? // 0 = 当月, 1 = 翌月, ...
  fixedPaymentDay         Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shifts                Shift[]
  clockRecords          ClockRecord[]
  shiftHistories        ShiftHistory[]
  monthlyEarningTargets MonthlyEarningTarget[]
  transferRequests      TransferRequest[]
  clockRecordHistories  ClockRecordHistory[]
  gameTitles            GameTitle[]
  perfectAttendances    PerfectAttendance[]
  workOrderAssignments  WorkOrderStaff[]
  expenses              Expense[]
  notices               Notice[]
  compensationRequests  CompensationRequest[]
}

model MonthlyEarningTarget {
  id           String   @id @default(cuid())
  staffId      String
  staff        Staff    @relation(fields: [staffId], references: [id])
  yearMonth    String // "YYYY-MM" (JST)
  targetAmount Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([staffId, yearMonth])
}

model Shift {
  id         String   @id @default(cuid())
  staffId    String
  staff      Staff    @relation(fields: [staffId], references: [id])
  workType   WorkType
  carrier    String
  storeName  String
  startTime  DateTime
  endTime    DateTime
  unitAmount Int? // SPOT稼働の1稼働分の単価。BAND稼働では未使用(null)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  histories    ShiftHistory[]
  clockRecords ClockRecord[]
  noShowAlert  NoShowAlert?
  workOrderStaffId String?
  workOrderStaff WorkOrderStaff? @relation(fields: [workOrderStaffId], references: [id], onDelete: SetNull)
  cancelledAt DateTime?
  cancellationReason String?
  cancelledBy String?

  @@index([staffId, startTime])
  @@index([workOrderStaffId])
}

model ShiftHistory {
  id         String   @id @default(cuid())
  shiftId    String?
  shift      Shift?   @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  staffId    String
  staff      Staff    @relation(fields: [staffId], references: [id])
  changeType String
  before     Json?
  after      Json
  changedAt  DateTime @default(now())

  @@index([shiftId])
  @@index([staffId])
}

model ClockRecord {
  id            String    @id @default(cuid())
  staffId       String
  staff         Staff     @relation(fields: [staffId], references: [id])
  type          ClockType
  timestamp     DateTime
  latitude      Float?
  longitude     Float?
  storeName     String?
  shiftId       String?
  shift         Shift?    @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  editedByAdmin Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  histories ClockRecordHistory[]

  @@index([staffId, timestamp])
}

// 管理者による打刻記録の手動修正・削除の履歴(item 60)。
// このアプリには個別の管理者アカウントがなく共通パスワードのみのため、
// 「操作した管理者」は自由記述の operatorName で記録する。
model ClockRecordHistory {
  id            String       @id @default(cuid())
  clockRecordId String?
  clockRecord   ClockRecord? @relation(fields: [clockRecordId], references: [id], onDelete: SetNull)
  staffId       String
  staff         Staff        @relation(fields: [staffId], references: [id])
  changeType    String // UPDATE | DELETE
  before        Json?
  after         Json?
  operatorName  String?
  changedAt     DateTime     @default(now())

  @@index([clockRecordId])
  @@index([staffId])
}

// スタッフからの振込申請(item 44-52)。
// 「確定した報酬額」と「実際に振り込まれた金額」は別概念として、
// TransferRequest はあくまで申請〜振込済みの記録のみを保持する。
model TransferRequest {
  id                String                @id @default(cuid())
  staffId           String
  staff             Staff                 @relation(fields: [staffId], references: [id])
  amount            Int
  desiredPaymentDate DateTime
  status            TransferRequestStatus @default(REQUESTING)
  requestedAt       DateTime              @default(now())
  paidAt            DateTime?
  paidAmount        Int?
  // 操作した管理者(自由記述。個別管理者アカウントがないため)
  paidByOperatorName String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([staffId, status])
}

model NoShowAlert {
  id      String   @id @default(cuid())
  shiftId String   @unique
  shift   Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  sentAt  DateTime @default(now())
}

model AdminEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// サポートBOTのFAQ。管理画面(BOT管理 → FAQ管理)から質問・回答・表示対象
// (スタッフ/取引先)・並び順・表示/非表示を管理する。コードを変更せずに
// 内容を追加・編集・削除でき、保存内容はBOT側に即座に反映される(BOTは
// 表示ページのレイアウトを描画するたびにこのテーブルを読みに行くため)。
model BotFaq {
  id         String         @id @default(cuid())
  audience   BotFaqAudience
  category   String
  question   String
  answer     String
  // 質問文以外にも一致させたい追加キーワード(カンマ区切り、任意)。
  keywords   String?
  visible    Boolean        @default(true)
  sortOrder  Int            @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([audience, visible, sortOrder])
}

// 掲示板形式のお知らせ。全スタッフが投稿・編集できる(仕様)。投稿者名は
// 投稿時点でスナップショットしておき、退職・強制削除後も表示上は名前が
// 残るようにする(authorId は onDelete: SetNull で紐付けだけ外す)。
model Notice {
  id           String   @id @default(cuid())
  authorId     String?
  author       Staff?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName   String
  body         String
  editedByName String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([createdAt])
}

// ゲーミフィケーション: 獲得済み称号(永続データ)。XP・コイン・現在ストリークは
// 打刻+シフトから毎回再計算する方式のためテーブルを持たない(src/lib/game.ts参照)。
// 条件を初めて満たした瞬間に1件だけ作成し、以後ストリークが途切れても削除しない。
model GameTitle {
  id         String        @id @default(cuid())
  staffId    String
  staff      Staff         @relation(fields: [staffId], references: [id])
  titleCode  GameTitleCode
  achievedAt DateTime      @default(now())

  @@unique([staffId, titleCode])
}

// ゲーミフィケーション: 月間皆勤賞(永続データ)。staffId + yearMonth 単位で、
// 過去月分も削除せず履歴として保持する。
model PerfectAttendance {
  id         String   @id @default(cuid())
  staffId    String
  staff      Staff    @relation(fields: [staffId], references: [id])
  yearMonth  String // "YYYY-MM" (JST)
  achievedAt DateTime @default(now())

  @@unique([staffId, yearMonth])
}


// ===== 取引先・稼働依頼・経費・請求（第2段階） =====
enum WorkOrderStatus {
  PENDING_APPROVAL
  APPROVED
  CHANGES_PENDING
  CANCELLED
  TERMINATED
}
enum ContractType {
  MONTHLY
  DAILY
}

enum WorkRequestType {
  CATCH
  CLOSER
  BAND
  CONSULTING
}

enum SchedulePattern {
  FIXED
  VARIES
}
enum AbsenceDeductionRule {
  YES
  NO
  CONSULT
}
enum TravelExpenseRule {
  INCLUDED
  SEPARATE
  CONSULT
}
enum OverrideApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}
enum ExpenseCategory {
  TRAVEL
  LODGING
  OTHER
}
enum CompensationCategory {
  REFERRAL
  INCENTIVE
  OTHER
}
enum BotFaqAudience {
  STAFF
  CLIENT
}
enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}
enum InvoiceStatus {
  DRAFT
  FINALIZED
  REISSUED
}

model Client {
  id String @id @default(cuid())
  name String
  clientCode String @unique
  contactName String?
  contactDepartment String?
  phone String?
  email String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  accessTokens ClientAccessToken[]
  workOrders WorkOrder[]
  invoices Invoice[]
}

model ClientAccessToken {
  id String @id @default(cuid())
  clientId String
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  token String @unique
  active Boolean @default(true)
  createdAt DateTime @default(now())
  revokedAt DateTime?
  @@index([clientId, active])
}

model WorkOrder {
  id String @id @default(cuid())
  clientId String
  client Client @relation(fields: [clientId], references: [id])
  yearMonth String
  plannedDays Int
  defaultStoreName String
  requestedCarrier String?
  requestType WorkRequestType @default(BAND)
  schedulePattern SchedulePattern @default(FIXED)
  fixedStartTime String?
  fixedEndTime String?
  notes String?
  status WorkOrderStatus @default(PENDING_APPROVAL)
  clientContactName String
  clientContactDepartment String?
  clientContactPhone String?
  clientContactEmail String?
  clientConfirmedAt DateTime @default(now())
  approvedAt DateTime?
  approverName String?
  approverPhone String?
  approverEmail String?
  cancelledAt DateTime?
  cancellationReason String?
  terminatedAt DateTime?
  terminationReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  staffAssignments WorkOrderStaff[]
  sites WorkOrderSite[]
  scheduleDays WorkOrderScheduleDay[]
  histories WorkOrderChangeHistory[]
  invoices InvoiceWorkOrder[]
  accessTokens WorkOrderAccessToken[]
  @@index([clientId, yearMonth])
  @@index([status])
}


model WorkOrderAccessToken {
  id String @id @default(cuid())
  workOrderId String
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  token String @unique
  active Boolean @default(true)
  createdAt DateTime @default(now())
  revokedAt DateTime?
  @@index([workOrderId, active])
}

model WorkOrderStaff {
  id String @id @default(cuid())
  workOrderId String
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  staffId String?
  staff Staff? @relation(fields: [staffId], references: [id])
  requestedName String
  contractType ContractType
  rateAmountExTax Int
  absenceDeduction AbsenceDeductionRule
  travelExpense TravelExpenseRule
  active Boolean @default(true)
  cancelledAt DateTime?
  cancellationReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shifts Shift[]
  dailyOverrides DailyWorkOverride[]
  expenses Expense[]
  @@index([workOrderId, requestedName])
  @@index([staffId])
}


model WorkOrderScheduleDay {
  id String @id @default(cuid())
  workOrderId String
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  workDate DateTime
  startTime String?
  endTime String?
  storeName String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([workOrderId, workDate])
}

model WorkOrderSite {
  id String @id @default(cuid())
  workOrderId String
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  storeName String
  startDate DateTime?
  endDate DateTime?
  rateOverrideExTax Int?
  travelExpense TravelExpenseRule?
  notes String?
  cancelledAt DateTime?
  cancellationReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([workOrderId])
}

model DailyWorkOverride {
  id String @id @default(cuid())
  workOrderStaffId String
  workOrderStaff WorkOrderStaff @relation(fields: [workOrderStaffId], references: [id], onDelete: Cascade)
  workDate DateTime
  originalStoreName String?
  changedStoreName String?
  originalRateExTax Int?
  changedRateExTax Int?
  originalTravelExpense TravelExpenseRule?
  changedTravelExpense TravelExpenseRule?
  lodgingOccurred Boolean @default(false)
  otherExpenseNote String?
  reason String
  approvalStatus OverrideApprovalStatus @default(PENDING)
  changedByRole String
  changedByName String
  createdAt DateTime @default(now())
  approvedAt DateTime?
  approvedByName String?
  @@index([workOrderStaffId, workDate])
}

model WorkOrderChangeHistory {
  id String @id @default(cuid())
  workOrderId String
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  entityType String
  entityId String?
  changeType String
  before Json?
  after Json?
  actorRole String
  actorName String
  reason String?
  changedAt DateTime @default(now())
  @@index([workOrderId, changedAt])
}

model Expense {
  id String @id @default(cuid())
  staffId String
  staff Staff @relation(fields: [staffId], references: [id])
  workOrderStaffId String?
  workOrderStaff WorkOrderStaff? @relation(fields: [workOrderStaffId], references: [id], onDelete: SetNull)
  yearMonth String
  expenseDate DateTime
  category ExpenseCategory
  description String?
  amountTaxInclusive Int
  amountExTax Int
  taxAmount Int
  taxRate Int @default(10)
  status ExpenseStatus @default(DRAFT)
  submittedAt DateTime?
  reviewedAt DateTime?
  reviewerName String?
  reviewNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([staffId, yearMonth])
  @@index([status])
}

// 別途報酬申請(item 8)。経費申請とは逆に、スタッフに追加で支払うべき報酬
// (リファラル報酬・インセンティブ等)をスタッフ自身が申請する。承認フローは
// Expense と同じ ExpenseStatus を再利用する。
model CompensationRequest {
  id String @id @default(cuid())
  staffId String
  staff Staff @relation(fields: [staffId], references: [id])
  yearMonth String
  category CompensationCategory
  description String?
  amountTaxInclusive Int
  amountExTax Int
  taxAmount Int
  taxRate Int @default(10)
  status ExpenseStatus @default(DRAFT)
  submittedAt DateTime?
  reviewedAt DateTime?
  reviewerName String?
  reviewNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([staffId, yearMonth])
  @@index([status])
}

model Invoice {
  id String @id @default(cuid())
  clientId String
  client Client @relation(fields: [clientId], references: [id])
  yearMonth String
  invoiceNumber String @unique
  revision Int @default(1)
  status InvoiceStatus @default(DRAFT)
  subtotalExTax Int @default(0)
  taxAmount Int @default(0)
  totalInclTax Int @default(0)
  finalizedAt DateTime?
  finalizedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lines InvoiceLine[]
  workOrders InvoiceWorkOrder[]
  @@index([clientId, yearMonth])
}

model InvoiceWorkOrder {
  id String @id @default(cuid())
  invoiceId String
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  workOrderId String
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])
  @@unique([invoiceId, workOrderId])
}

model InvoiceLine {
  id String @id @default(cuid())
  invoiceId String
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sortOrder Int
  itemType String
  label String
  description String?
  unitPriceExTax Int
  quantity Int @default(1)
  subtotalExTax Int
  taxAmount Int
  totalInclTax Int
  @@index([invoiceId, sortOrder])
}
